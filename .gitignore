.playwright-mcp/

# local UI baseline + phase screenshots for the RR migration
/screenshots/

# Prisma client output (npm run db:generate / postinstall)
/src/db/generated/

# er review runs (they ignore themselves; listed for Prettier, which reads only this file)
/er-reviews/
