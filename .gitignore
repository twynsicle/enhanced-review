# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifact: drizzle/migrate.mts is compiled to drizzle/migrate.mjs
# inside the Docker build stage; never committed.
drizzle/migrate.mjs

# terraform: provider cache, local state, and local var files. CI gets
# vars from GitHub secrets via TF_VAR_* env in deploy-infra.yml; local
# applies can use terraform.tfvars (not committed). State lives in S3.
# .terraform.lock.hcl is intentionally NOT ignored — commit it for
# reproducible provider versions across machines.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# claude code (user-local permission overrides; project-shared settings.json is fine)
.claude/settings.local.json

# playwright mcp runtime artifacts (console logs + page snapshots)
.playwright-mcp/
