# dependencies
/node_modules

# build output (react-router build, jobs bundle) and generated route types
/build
/.react-router

# tests
/coverage

# env files — .env.example is the committed template
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*

