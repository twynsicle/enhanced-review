# enhanced-review — environment template.
#
# Copy to `.env` (gitignored) and fill in real values. Every key is validated
# by src/config/env.ts at startup; an invalid or missing required value fails
# the boot with a message naming the key.
#
# Later migration phases append their keys here in the commit that adds them
# (Phase 2: database + auth; Phase 3: review runner; Phase 4: polling).

# --- Server ------------------------------------------------------------------

# development | production | test. `npm run dev` leaves it unset (development);
# `npm start` and the container set production.
# NODE_ENV=development

# HTTP port for the Express server.
# PORT=3000

# Reported by GET /api/health. The container build sets it to the image tag.
# APP_VERSION=

# --- Logging -----------------------------------------------------------------

# Pino level: trace | debug | info | warn | error | fatal | silent.
# LOG_LEVEL=info

# 1 = human-friendly coloured output via pino-pretty (dev only).
# LOG_PRETTY=1

# --- Database ----------------------------------------------------------------

# Postgres connection string (Prisma + pg). The value below matches
# docker-compose.yml's postgres service.
DATABASE_URL=postgresql://enhanced_review:enhanced_review@127.0.0.1:5432/enhanced_review

# --- Auth --------------------------------------------------------------------

# Signs the er_session and gh_access_token cookies. At least 32 characters;
# rotating it signs everyone out. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Its
# authorization callback URL must be <APP_ORIGIN>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public origin the app is served from; builds the OAuth redirect URI and
# turns on Secure cookies when https.
APP_ORIGIN=http://localhost:3000
