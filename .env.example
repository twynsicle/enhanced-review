# enhanced-review — Next.js environment template.
#
# Copy this file to .env.local (gitignored) and fill in real values.

# --- PocketBase ------------------------------------------------------------

# Browser- and server-side base URL. Same value in dev; can diverge in
# AWS deployments where the Next.js task talks to PB over an internal host.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials for server-side admin actions (allowlist lookups,
# populating github_login on user records after OAuth). Created via
# `./tools/pocketbase/pocketbase.exe superuser create EMAIL PASSWORD
# --dir="$(pwd)/pb_data"` — see docs/RUNNING.md §3.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- Review runner ---------------------------------------------------------

# Executor backend. Use 'stub' locally to exercise the full streaming path
# with synthetic output. Use 'claude' (the default) in production to run the
# real Claude Agent SDK reviewer (requires ANTHROPIC_API_KEY).
REVIEW_EXECUTOR=stub

# Claude model identifier. Ignored when REVIEW_EXECUTOR=stub.
# REVIEW_MODEL=claude-haiku-4-5

# Anthropic API key. Required when REVIEW_EXECUTOR=claude. Read by the
# Claude Agent SDK directly from the environment; never persisted to the DB.
# ANTHROPIC_API_KEY=

# Per-job wall-clock timeout in minutes. Jobs exceeding this are marked
# status='error' and their AbortController is aborted.
# REVIEW_TIMEOUT_MIN=15

# Per-user concurrency cap. Default 1 = a user can have at most one
# pending-or-running review at a time; another submission while one is in
# flight returns 409 with a link to the active job.
# MAX_JOBS_PER_USER=1

# Pino logger config.
#   LOG_LEVEL: one of trace|debug|info|warn|error|fatal (default: info).
#   LOG_PRETTY=1 swaps in pino-pretty for human-friendly dev output.
# LOG_LEVEL=info
# LOG_PRETTY=1
