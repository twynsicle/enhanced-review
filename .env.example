# enhanced-review — Next.js environment template.
#
# Copy this file to .env.local (gitignored) and fill in real values.

# --- Postgres + Auth.js ---------------------------------------------------

# Postgres connection string. Matches the docker-compose.yml service in the
# repo root: `docker compose up postgres -d` exposes 5432 on the host with
# user/password/db all set to "app" / "app" / "enhanced_review" by default.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/enhanced_review

# Auth.js v5 secret used to sign session cookies. Generate locally with:
#   openssl rand -base64 32
# Required by next-auth even with database sessions (used for CSRF / state).
AUTH_SECRET=

# Public origin Auth.js uses to build OAuth callback URLs. Match dev server.
# In Flow 1 (full Docker) docker-compose.yml sets this for the web service
# along with AUTH_TRUST_HOST=true; you don't need either in .env.local for
# Flow 2 (host npm dev) since localhost is implicitly trusted.
AUTH_URL=http://localhost:3000

# GitHub OAuth app credentials. Update the OAuth app's callback URL to:
#   http://localhost:3000/api/auth/callback/github  (dev)
#   https://<your-domain>/api/auth/callback/github  (after Phase C deploy)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Used by `npm run db:seed` to insert your github_login into allowed_users.
# Idempotent — safe to re-run. Leave unset to skip seeding.
SEED_GITHUB_LOGIN=

# --- Review runner --------------------------------------------------------

# Executor backend. Use 'stub' locally to exercise the full streaming path
# with synthetic output. Use 'claude' (the default) in production to run the
# real Claude Agent SDK reviewer (requires ANTHROPIC_API_KEY).
REVIEW_EXECUTOR=stub

# Claude model identifier. Ignored when REVIEW_EXECUTOR=stub.
# REVIEW_MODEL=claude-haiku-4-5

# Anthropic API key. Required when REVIEW_EXECUTOR=claude. Read by the
# Claude Agent SDK directly from the environment; never persisted to the DB.
# ANTHROPIC_API_KEY=

# Per-job wall-clock timeout in minutes. Jobs exceeding this are marked
# status='error' and their AbortController is aborted.
# REVIEW_TIMEOUT_MIN=15

# Per-user concurrency cap. Default 1 = a user can have at most one
# pending-or-running review at a time; another submission while one is in
# flight returns 409 with a link to the active job.
# MAX_JOBS_PER_USER=1

# Pino logger config.
#   LOG_LEVEL: one of trace|debug|info|warn|error|fatal (default: info).
#   LOG_PRETTY=1 swaps in pino-pretty for human-friendly dev output.
# LOG_LEVEL=info
# LOG_PRETTY=1
