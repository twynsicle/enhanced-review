{
  "name": "enhanced-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "er": "src/cli/er.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.ts",
    "build": "react-router build",
    "viewer:dev": "vite --config vite.viewer.config.ts",
    "viewer:build": "vite build --config vite.viewer.config.ts",
    "start": "cross-env NODE_ENV=production node server/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && prisma generate",
    "db:studio": "prisma studio",
    "job": "node src/jobs/cli.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project web --project guardrails",
    "test:watch": "vitest --project unit --project web --project guardrails",
    "test:integration": "vitest run --project integration",
    "check": "npm run typecheck && npm run build && npm run viewer:build && npm run test && npm run lint && npm run format:check",
    "check:all": "npm run check && npm run test:integration"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.119",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@octokit/core": "7.0.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/express": "^8.3.1",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "isbot": "^5.1.0",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remix-auth": "4.2.0",
    "remix-auth-github": "3.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-router/dev": "^8.3.1",
    "@tabler/icons-react": "^3.46.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.0",
    "monaco-editor": "^0.56.0",
    "oxlint": "^1.82.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
