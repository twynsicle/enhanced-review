diff --git a/src/i18n/index.ts b/src/i18n/index.ts
index 6ac2cd3..eeb6baa 100644
--- a/src/i18n/index.ts
+++ b/src/i18n/index.ts
# H0007
@@ -1,10 +1,17 @@
 import de from './de.json' with { type: 'json' };
 import en from './en.json' with { type: 'json' };
+import fr from './fr.json' with { type: 'json' };
 
-const tables: Record<string, Record<string, string>> = { en, de };
+const tables: Record<string, Record<string, string>> = { en, de, fr };
 
 export function t(locale: string, key: string, vars: Record<string, string | number> = {}): string {
   const table = tables[locale] ?? tables.en!;
   const text = table[key] ?? en[key as keyof typeof en] ?? key;
   return text.replace(/\{(\w+)\}/g, (_, name: string) => String(vars[name] ?? `{${name}}`));
 }
+
+/** A count in the locale's own digits and grouping: 12 345 in French, 12.345 in German. */
+export function formatCount(locale: string, count: number): string {
+  const tag = locale in tables ? locale : 'en';
+  return new Intl.NumberFormat(tag, { maximumFractionDigits: 0 }).format(count);
+}

diff --git a/src/sync/report.ts b/src/sync/report.ts
index 9d835d8..0dad8a4 100644
--- a/src/sync/report.ts
+++ b/src/sync/report.ts
# H0008
@@ -5,18 +5,25 @@ export interface SyncReport {
   unchanged: number;
   unknown: number;
   largest: { sku: string; depot: string; by: number } | null;
+  /** Items changed per depot, depots in name order. */
+  byDepot: { depot: string; changed: number }[];
 }
 
 export function summarise(result: ReconcileResult): SyncReport {
   let largest: SyncReport['largest'] = null;
+  const perDepot = new Map<string, number>();
   for (const adj of result.adjustments) {
     const by = Math.abs(adj.to - adj.from);
     if (!largest || by > largest.by) largest = { sku: adj.sku, depot: adj.depot, by };
+    perDepot.set(adj.depot, (perDepot.get(adj.depot) ?? 0) + 1);
   }
   return {
     changed: result.adjustments.length,
     unchanged: result.unchanged,
     unknown: result.unknown.length,
     largest,
+    byDepot: [...perDepot.entries()]
+      .toSorted(([a], [b]) => a.localeCompare(b))
+      .map(([depot, changed]) => ({ depot, changed })),
   };
 }

